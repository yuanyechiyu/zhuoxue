# 这张名单里的每一行都是一种「不要记录」的规则

# 真实密钥放这里，不能进版本库
.env

# 所有后缀为 key 的文件都排除
*.key

# Java 编译产物目录
target/

# Python 运行后生成的缓存目录
__pycache__/
*.pyc

# 前端第三方包目录
node_modules/

# 前端打包产物
dist/

# IntelliJ IDEA 的工程设置
.idea/
*.iml

# VS Code 的工程设置
.vscode/

# 运行日志
*.log

# 系统生成的缩略图记录
.DS_Store

# 本地配置文件（真实密钥只放本地，不进版本库）
application-local.yaml

# 真实配置（含密钥）只放本地，仓库里只提交 application.yaml.example
zhuoxue-api/src/main/resources/application.yaml